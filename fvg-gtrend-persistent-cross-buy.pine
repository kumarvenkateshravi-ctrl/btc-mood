//@version=6
indicator("FVG + G-Trend + Persistent Cross BUY", overlay = true, max_boxes_count = 100, max_labels_count = 500)

// ── Inputs ─────────────────────────────────────────────────────────────────
gLength       = input.int(100, "G-Trend Length", minval = 1, group = "G-Trend")
showGTrend    = input.bool(true, "Show G-Trend", group = "G-Trend")
bullTrend     = input.color(color.rgb(0, 168, 138), "Bullish Color", group = "G-Trend")
bearTrend     = input.color(color.rgb(224, 82, 96), "Bearish Color", group = "G-Trend")

maxAgeBars    = input.int(200, "Maximum FVG Age (Bars)", minval = 1, group = "Fair Value Gaps")
maxActiveFvgs = input.int(30, "Maximum Active FVGs", minval = 1, maxval = 100, group = "Fair Value Gaps")
showFvg       = input.bool(true, "Show Active FVGs", group = "Fair Value Gaps")
bullFvgColor  = input.color(color.new(color.rgb(0, 168, 138), 84), "Bullish FVG", group = "Fair Value Gaps")
bearFvgColor  = input.color(color.new(color.rgb(224, 82, 96), 84), "Bearish FVG", group = "Fair Value Gaps")

requireReclaim = input.bool(true, "Require Midpoint Reclaim", group = "Confirmation")
cooldownBars   = input.int(6, "Signal Cooldown (Bars)", minval = 0, group = "Confirmation")
showSignals    = input.bool(true, "Show Buy/Sell Signals", group = "Display")

// VWAP is calculated here because the supplied script did not contain it.
showSessionVwap = input.bool(true, "Show Session VWAP", group = "Session VWAP")
vwapSource = input.source(hlc3, "VWAP Source", group = "Session VWAP")
vwapColor = input.color(color.rgb(66, 165, 245), "VWAP Color", group = "Session VWAP")
newVwapSession = timeframe.change("1D")
sessionVwap = ta.vwap(vwapSource, newVwapSession or barstate.isfirst)
plot(showSessionVwap ? sessionVwap : na, "Session VWAP", color = vwapColor, linewidth = 2)

showCrossBuys = input.bool(true, "Show persistent crossing BUY markers", group = "Persistent Cross BUY")
useVwapCross = input.bool(true, "Session VWAP crossing", group = "Persistent Cross BUY")
useGTrendCross = input.bool(true, "G-Trend Average crossing", group = "Persistent Cross BUY")
crossMode = input.string("Either condition", "Cross definition", options = ["Either condition", "Line enters bullish FVG from below", "Bullish FVG candle body touches line"], group = "Persistent Cross BUY", tooltip = "Either condition: a line enters the FVG from below, OR a green candle body touches the line. Body touch qualifies on the candle confirming a new bullish FVG, or when the line is inside an existing bullish FVG. A jump across the complete zone counts as entry. Each line can mark each FVG once.")

crossesBullFvg(value, previousValue, bottom, top, formationCandle) =>
    bool lineEntry = not na(previousValue) and not na(value) and ((previousValue < bottom and value >= bottom) or (previousValue == bottom and value > bottom))
    bool bodyTouch = not na(value) and close > open and open <= value and close >= value and (formationCandle or (value >= bottom and value <= top))
    crossMode == "Either condition" ? lineEntry or bodyTouch : crossMode == "Line enters bullish FVG from below" ? lineEntry : bodyTouch

// ── G-Trend regime ──────────────────────────────────────────────────────────
var float gUpper = na
var float gLower = na

gUpper := na(gUpper[1]) ? close : math.max(close, gUpper[1]) - (gUpper[1] - gLower[1]) / gLength
gLower := na(gLower[1]) ? close : math.min(close, gLower[1]) + (gUpper[1] - gLower[1]) / gLength
gAverage = (gUpper + gLower) / 2

lowerCrossesPrice = gLower[1] < close[1] and gLower > close
upperCrossesPrice = gUpper[1] < close[1] and gUpper > close

barsSinceLowerCross = ta.barssince(lowerCrossesPrice)
barsSinceUpperCross = ta.barssince(upperCrossesPrice)

// Same regime model used by the app's G-Channel implementation.
gBullish = not na(barsSinceLowerCross) and not na(barsSinceUpperCross) and barsSinceUpperCross <= barsSinceLowerCross

plot(
     showGTrend ? gAverage : na,
     "G-Trend Average",
     color = gBullish ? bullTrend : bearTrend,
     linewidth = 2
)

// ── FVG storage ─────────────────────────────────────────────────────────────
// Direction: 1 = bullish FVG, -1 = bearish FVG.
var box[] fvgBoxes = array.new_box()
var float[] fvgTops = array.new_float()
var float[] fvgBottoms = array.new_float()
var int[] fvgDirections = array.new_int()
var int[] fvgCreatedBars = array.new_int()
var bool[] fvgConsumed = array.new_bool()
// Independent from the original retest's consumed flag and signal cooldown.
var bool[] fvgVwapMarked = array.new_bool()
var bool[] fvgGTrendMarked = array.new_bool()

removeFvg(index) =>
    box.delete(array.get(fvgBoxes, index))
    array.remove(fvgBoxes, index)
    array.remove(fvgTops, index)
    array.remove(fvgBottoms, index)
    array.remove(fvgDirections, index)
    array.remove(fvgCreatedBars, index)
    array.remove(fvgConsumed, index)
    array.remove(fvgVwapMarked, index)
    array.remove(fvgGTrendMarked, index)

addFvg(top, bottom, direction) =>
    // Evict before drawing so TradingView's box limit cannot delete a box
    // still referenced by our arrays when maxActiveFvgs is set to 100.
    if array.size(fvgBoxes) >= maxActiveFvgs
        removeFvg(0)
    zoneColor = direction == 1 ? bullFvgColor : bearFvgColor
    borderColor = direction == 1 ? bullTrend : bearTrend
    newBox = box.new(
         left = bar_index - 2,
         top = top,
         right = bar_index,
         bottom = bottom,
         xloc = xloc.bar_index,
         bgcolor = showFvg ? zoneColor : na,
         border_color = showFvg ? borderColor : na
     )

    array.push(fvgBoxes, newBox)
    array.push(fvgTops, top)
    array.push(fvgBottoms, bottom)
    array.push(fvgDirections, direction)
    array.push(fvgCreatedBars, bar_index)
    array.push(fvgConsumed, false)
    array.push(fvgVwapMarked, false)
    array.push(fvgGTrendMarked, false)

// ── FVG lifecycle and signal generation ─────────────────────────────────────
var int lastSignalBar = na
bool buySignal = false
bool sellSignal = false
bool vwapCrossBuy = false
bool gTrendCrossBuy = false

// Historical bars are confirmed. On live data, this prevents a signal from
// appearing until the candle closes.
if barstate.isconfirmed
    // Update / expire existing FVGs before evaluating a trade signal.
    if array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            fvgBox = array.get(fvgBoxes, i)
            top = array.get(fvgTops, i)
            bottom = array.get(fvgBottoms, i)
            direction = array.get(fvgDirections, i)
            createdBar = array.get(fvgCreatedBars, i)

            expired = bar_index - createdBar > maxAgeBars
            mitigated = direction == 1 ? close < bottom : close > top

            if expired or mitigated
                removeFvg(i)
            else
                zoneColor = direction == 1 ? bullFvgColor : bearFvgColor
                borderColor = direction == 1 ? bullTrend : bearTrend
                box.set_right(fvgBox, bar_index)
                box.set_bgcolor(fvgBox, showFvg ? zoneColor : na)
                box.set_border_color(fvgBox, showFvg ? borderColor : na)

    // Create new FVGs only from confirmed candles.
    bullishFvg = bar_index >= 2 and low > high[2] and close[1] > high[2]
    bearishFvg = bar_index >= 2 and high < low[2] and close[1] < low[2]

    if bullishFvg
        addFvg(low, high[2], 1)

    if bearishFvg
        addFvg(low[2], high, -1)

    // Record events while the FVG is known and active, including its creation
    // candle. A new FVG is known only when the third candle closes; no marker
    // is placed on either of the earlier candles used to detect that gap.
    // The plotted event is a historical series value, not a label owned by
    // the box. Future mitigation, expiry or capacity eviction cannot erase it.
    if array.size(fvgBoxes) > 0
        for i = array.size(fvgBoxes) - 1 to 0
            if array.get(fvgDirections, i) == 1
                top = array.get(fvgTops, i)
                bottom = array.get(fvgBottoms, i)
                formationCandle = bar_index == array.get(fvgCreatedBars, i)
                // Ignore the daily VWAP reset jump, but a real candle-body
                // touch during the new session can still qualify.
                vwapEvent = useVwapCross and not array.get(fvgVwapMarked, i) and crossesBullFvg(sessionVwap, newVwapSession ? na : sessionVwap[1], bottom, top, formationCandle)
                gEvent = useGTrendCross and not array.get(fvgGTrendMarked, i) and crossesBullFvg(gAverage, gAverage[1], bottom, top, formationCandle)
                if vwapEvent
                    vwapCrossBuy := true
                    array.set(fvgVwapMarked, i, true)
                if gEvent
                    gTrendCrossBuy := true
                    array.set(fvgGTrendMarked, i, true)

    // G-Trend direction must agree with the FVG direction.
    cooldownComplete = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars

    if showSignals and cooldownComplete and array.size(fvgBoxes) > 0
        // Work from newest FVG to oldest, so the latest valid zone gets priority.
        for i = array.size(fvgBoxes) - 1 to 0
            if not buySignal and not sellSignal
                top = array.get(fvgTops, i)
                bottom = array.get(fvgBottoms, i)
                direction = array.get(fvgDirections, i)
                createdBar = array.get(fvgCreatedBars, i)
                consumed = array.get(fvgConsumed, i)

                midpoint = (top + bottom) / 2
                touched = low <= top and high >= bottom
                reclaimed = direction == 1 ? close >= midpoint : close <= midpoint

                validBuy = gBullish and direction == 1 and bar_index > createdBar and not consumed and touched and (not requireReclaim or reclaimed)
                validSell = not gBullish and direction == -1 and bar_index > createdBar and not consumed and touched and (not requireReclaim or reclaimed)

                if validBuy
                    buySignal := true
                    lastSignalBar := bar_index
                    array.set(fvgConsumed, i, true)

                if validSell
                    sellSignal := true
                    lastSignalBar := bar_index
                    array.set(fvgConsumed, i, true)

// ── Signal markers and alerts ───────────────────────────────────────────────
// One BUY per candle, even if both lines or several overlapping FVGs cross.
// Original retest BUY/SELL signals remain available via their existing toggle.
persistentCrossBuy = vwapCrossBuy or gTrendCrossBuy
visibleBuy = buySignal or (showCrossBuys and persistentCrossBuy)
plotshape(
     visibleBuy,
     title = "FVG Buy",
     text = "BUY",
     style = shape.labelup,
     location = location.belowbar,
     color = bullTrend,
     textcolor = color.white,
     size = size.small
)

plotshape(
     sellSignal,
     title = "FVG Sell",
     text = "SELL",
     style = shape.labeldown,
     location = location.abovebar,
     color = bearTrend,
     textcolor = color.white,
     size = size.small
)

alertcondition(buySignal, "FVG + G-Trend Buy", "Bullish G-Trend FVG retest and reclaim confirmed.")
alertcondition(sellSignal, "FVG + G-Trend Sell", "Bearish G-Trend FVG retest and reclaim confirmed.")
alertcondition(vwapCrossBuy, "BUY - Session VWAP / FVG", "Session VWAP bullish FVG crossing confirmed at candle close on {{ticker}} {{interval}}.")
alertcondition(gTrendCrossBuy, "BUY - G-Trend / FVG", "G-Trend Average bullish FVG crossing confirmed at candle close on {{ticker}} {{interval}}.")
alertcondition(persistentCrossBuy, "BUY - Either line / FVG", "Session VWAP or G-Trend bullish FVG crossing confirmed at candle close on {{ticker}} {{interval}}.")

// Select a marked candle to inspect which event generated its BUY.
plot(vwapCrossBuy ? 1 : 0, "Cross BUY: VWAP", display = display.data_window)
plot(gTrendCrossBuy ? 1 : 0, "Cross BUY: G-Trend", display = display.data_window)
plot(buySignal ? 1 : 0, "Original retest BUY", display = display.data_window)
