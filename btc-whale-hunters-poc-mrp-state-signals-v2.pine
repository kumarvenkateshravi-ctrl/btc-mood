//@version=6
indicator("BTC WHALE HUNTER'S - POC & MRP [State Signals V2]", shorttitle = "POC State Signals V2", overlay = true, format = format.price, precision = 2, max_bars_back = 5000, max_labels_count = 100)

// Functional reconstruction from observed chart values. This is not the
// protected source code and does not use volume-profile bins.

GRP_MRP = "MRP / WMRP"
GRP_POC = "POC LINES"
GRP_SIG = "BUY / SELL SIGNALS"

showMrp = input.bool(true, "Show MRP", inline = "mrp", group = GRP_MRP)
showWMrp = input.bool(true, "Show WMRP", inline = "mrp", group = GRP_MRP)
showMrpNames = input.bool(true, "Show MRP / WMRP Name Tags", group = GRP_MRP)
nameTagOffset = input.int(2, "Name Tag Offset", minval = 0, maxval = 20, group = GRP_MRP)

showWeeklyPoc = input.bool(true, "Show Weekly POC", group = GRP_POC)
showDailyPoc = input.bool(true, "Show Daily POC", group = GRP_POC)
showFourHourPoc = input.bool(true, "Show 4-Hour POC", group = GRP_POC)
weeklyPocColor = input.color(#F59E0B, "Weekly POC Color", group = GRP_POC)
dailyPocColor = input.color(#14532D, "Daily POC Color", group = GRP_POC)
fourHourPocColor = input.color(#22D3EE, "4-Hour POC Color", group = GRP_POC)
pocLineWidth = input.int(2, "POC Line Width", minval = 1, maxval = 4, group = GRP_POC)

showSignals = input.bool(true, "Show BUY / SELL Signals", group = GRP_SIG)
showShiftMarkers = input.bool(true, "Show Genuine 4H Trend Shifts", group = GRP_SIG)
weekdaysOnly = input.bool(true, "Signals Monday to Friday Only", group = GRP_SIG)

MRP_COLOR = #0B46F0
WMRP_COLOR = #C57A00

const int FOUR_HOURS_MS = 4 * 60 * 60 * 1000
const int DAY_MS = 24 * 60 * 60 * 1000

int fourHourKey = int(math.floor(time / FOUR_HOURS_MS))
int dayKey = int(math.floor(time / DAY_MS))
int weekKey = int(math.floor((dayKey + 3) / 7))

bool newFourHour = barstate.isfirst or fourHourKey != fourHourKey[1]
bool newDay = barstate.isfirst or dayKey != dayKey[1]
bool newWeek = barstate.isfirst or weekKey != weekKey[1]

// Developing chart-timeframe Daily and Weekly HLC3 VWAPs.
float sourceVolume = nz(volume, 0.0)
float sourcePriceVolume = hlc3 * sourceVolume

var float dailyPv = 0.0
var float dailyVolume = 0.0
var float weeklyPv = 0.0
var float weeklyVolume = 0.0

if newDay
    dailyPv := 0.0
    dailyVolume := 0.0
if newWeek
    weeklyPv := 0.0
    weeklyVolume := 0.0

dailyPv += sourcePriceVolume
dailyVolume += sourceVolume
weeklyPv += sourcePriceVolume
weeklyVolume += sourceVolume

float mrp = dailyVolume > 0 ? dailyPv / dailyVolume : na
float wmrp = weeklyVolume > 0 ? weeklyPv / weeklyVolume : na

plot(showMrp ? mrp : na, "MRP — Daily VWAP", color = MRP_COLOR, linewidth = 2)
plot(showWMrp ? wmrp : na, "WMRP — Weekly VWAP", color = WMRP_COLOR, linewidth = 2)

var label mrpNameTag = na
var label wmrpNameTag = na
if barstate.islast
    label.delete(mrpNameTag)
    label.delete(wmrpNameTag)
    mrpNameTag := na
    wmrpNameTag := na
    if showMrp and showMrpNames and not na(mrp)
        mrpNameTag := label.new(bar_index + nameTagOffset, mrp, "MRP", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = MRP_COLOR, textcolor = color.white, size = size.small)
    if showWMrp and showMrpNames and not na(wmrp)
        wmrpNameTag := label.new(bar_index + nameTagOffset, wmrp, "WMRP", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_label_left, color = WMRP_COLOR, textcolor = color.white, size = size.small)

// Exact 4H POC: cumulative UTC-day VWAP from completed native 4H HLC3 bars.
f_developingDailyVwapFrom4H() =>
    const int LOCAL_DAY_MS = 24 * 60 * 60 * 1000
    int localDayKey = int(math.floor(time / LOCAL_DAY_MS))
    bool localNewDay = barstate.isfirst or localDayKey != localDayKey[1]
    float localVolume = nz(volume, 0.0)
    var float localPvSum = 0.0
    var float localVolumeSum = 0.0
    if localNewDay
        localPvSum := 0.0
        localVolumeSum := 0.0
    localPvSum += hlc3 * localVolume
    localVolumeSum += localVolume
    localVolumeSum > 0 ? localPvSum / localVolumeSum : na

float fourHourPoc = request.security(
     syminfo.tickerid, "240", f_developingDailyVwapFrom4H()[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

// Monday open, fixed throughout the UTC week.
float weeklyPoc = request.security(
     syminfo.tickerid, "1W", open,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

// Confirmed previous-day pivot, fixed throughout the UTC day.
float dailyPoc = request.security(
     syminfo.tickerid, "1D", (high[1] + low[1] + close[1]) / 3,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

color fourHourPlotColor = newFourHour and not barstate.isfirst ? na : fourHourPocColor
color dailyPlotColor = newDay and not barstate.isfirst ? na : dailyPocColor
color weeklyPlotColor = newWeek and not barstate.isfirst ? na : weeklyPocColor

plot(showWeeklyPoc ? weeklyPoc : na, "Weekly POC", color = weeklyPlotColor, linewidth = pocLineWidth, style = plot.style_linebr)
plot(showDailyPoc ? dailyPoc : na, "Daily POC", color = dailyPlotColor, linewidth = pocLineWidth, style = plot.style_linebr)
plot(showFourHourPoc ? fourHourPoc : na, "4-Hour POC", color = fourHourPlotColor, linewidth = pocLineWidth, style = plot.style_linebr)

// Persistent entry state: one signal when the structure activates, no repeated
// signal while that structure remains valid.
bool bullishStructure = dailyPoc > weeklyPoc and fourHourPoc > dailyPoc
bool bearishStructure = dailyPoc < weeklyPoc and fourHourPoc < dailyPoc
bool priceAboveAllPocs = close > weeklyPoc and close > dailyPoc and close > fourHourPoc
bool priceBelowAllPocs = close < weeklyPoc and close < dailyPoc and close < fourHourPoc

int utcDayOfWeek = dayofweek(time, "UTC")
bool isWeekday = utcDayOfWeek >= dayofweek.monday and utcDayOfWeek <= dayofweek.friday
bool signalDayAllowed = not weekdaysOnly or isWeekday

// 0 = neutral/pending, 1 = BUY active, -1 = SELL active.
var int signalState = 0
if newDay
    signalState := 0
if signalState == 1 and not bullishStructure
    signalState := 0
if signalState == -1 and not bearishStructure
    signalState := 0

bool buySignal = showSignals and barstate.isconfirmed and signalDayAllowed and signalState == 0 and bullishStructure and priceAboveAllPocs
bool sellSignal = showSignals and barstate.isconfirmed and signalDayAllowed and signalState == 0 and bearishStructure and priceBelowAllPocs

if buySignal
    signalState := 1
else if sellSignal
    signalState := -1

plotshape(buySignal, title = "BUY", style = shape.labelup, location = location.belowbar, color = #16A34A, text = "BUY", textcolor = color.white, size = size.small)
plotshape(sellSignal, title = "SELL", style = shape.labeldown, location = location.abovebar, color = #DC2626, text = "SELL", textcolor = color.white, size = size.small)

alertcondition(buySignal, "POC Structure BUY", "BUY activated: Weekly POC < Daily POC < 4H POC and price is above all three on {{ticker}} {{interval}} at {{close}}")
alertcondition(sellSignal, "POC Structure SELL", "SELL activated: Weekly POC > Daily POC > 4H POC and price is below all three on {{ticker}} {{interval}} at {{close}}")

// Genuine 4H trend shifts only. Continuation steps and MRP-spread expansion do
// not create markers. A flat step preserves the last direction.
var int fourHourTrendDirection = 0
bool bullishShift = false
bool bearishShift = false

if newFourHour and not barstate.isfirst and not na(fourHourPoc) and not na(fourHourPoc[1])
    float currentStepDelta = fourHourPoc - fourHourPoc[1]
    int currentDirection = currentStepDelta > 0 ? 1 : currentStepDelta < 0 ? -1 : 0

    bullishShift := currentDirection == 1 and fourHourTrendDirection == -1 and mrp > fourHourPoc
    bearishShift := currentDirection == -1 and fourHourTrendDirection == 1 and mrp < fourHourPoc

    if currentDirection != 0
        fourHourTrendDirection := currentDirection

plotshape(showShiftMarkers and bullishShift, title = "Bullish 4H Shift", style = shape.diamond, location = location.belowbar, color = #38BDF8, text = "B SHIFT", textcolor = color.white, size = size.tiny)
plotshape(showShiftMarkers and bearishShift, title = "Bearish 4H Shift", style = shape.diamond, location = location.abovebar, color = #F97316, text = "S SHIFT", textcolor = color.white, size = size.tiny)

alertcondition(showShiftMarkers and bullishShift, "Bullish 4H POC Shift", "Genuine bullish 4H POC direction reversal on {{ticker}} {{interval}} at {{close}}")
alertcondition(showShiftMarkers and bearishShift, "Bearish 4H POC Shift", "Genuine bearish 4H POC direction reversal on {{ticker}} {{interval}} at {{close}}")
