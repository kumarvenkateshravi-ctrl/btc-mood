//@version=6
indicator("MRP / WMRP — Endpoint Names Only", shorttitle="VWAP Names", overlay=true,
     max_labels_count=2, max_boxes_count=2)

// Add this alongside ADSZ. Each name is rendered twice at the same coordinate:
// one label plus one transparent text box. If Pane labels are disabled the box
// remains; if Boxes are disabled the label remains. Only disabling both object
// classes (or hiding this entire indicator) can suppress the endpoint names.

float mrp = ta.vwap(hlc3, barstate.isfirst or timeframe.change("D"))
float wmrp = ta.vwap(hlc3, barstate.isfirst or timeframe.change("W"))

var label mrp_name = na
var label wmrp_name = na
var box mrp_name_backup = na
var box wmrp_name_backup = na

float text_half_height = math.max(math.max(ta.atr(14) * 0.75,
     math.abs(close) * 0.00075), syminfo.mintick * 20)

if barstate.islast
    if not na(mrp)
        if na(mrp_name)
            mrp_name := label.new(x=bar_index, y=mrp, text="MRP",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_left, color=color.new(color.white, 100),
                 textcolor=#0B46F0, size=size.normal, textalign=text.align_left,
                 text_formatting=text.format_bold)
        label.set_xy(mrp_name, bar_index, mrp)
        if na(mrp_name_backup)
            mrp_name_backup := box.new(left=bar_index, top=mrp + text_half_height,
                 right=bar_index + 12, bottom=mrp - text_half_height,
                 xloc=xloc.bar_index, border_color=na, bgcolor=na, text="MRP",
                 text_size=size.normal, text_color=#0B46F0,
                 text_halign=text.align_left, text_valign=text.align_center,
                 text_wrap=text.wrap_none, text_formatting=text.format_bold)
        box.set_lefttop(mrp_name_backup, bar_index, mrp + text_half_height)
        box.set_rightbottom(mrp_name_backup, bar_index + 12, mrp - text_half_height)
    else
        label.delete(mrp_name)
        mrp_name := na
        box.delete(mrp_name_backup)
        mrp_name_backup := na

    if not na(wmrp)
        if na(wmrp_name)
            wmrp_name := label.new(x=bar_index, y=wmrp, text="WMRP",
                 xloc=xloc.bar_index, yloc=yloc.price,
                 style=label.style_label_left, color=color.new(color.white, 100),
                 textcolor=#C57A00, size=size.normal, textalign=text.align_left,
                 text_formatting=text.format_bold)
        label.set_xy(wmrp_name, bar_index, wmrp)
        if na(wmrp_name_backup)
            wmrp_name_backup := box.new(left=bar_index, top=wmrp + text_half_height,
                 right=bar_index + 12, bottom=wmrp - text_half_height,
                 xloc=xloc.bar_index, border_color=na, bgcolor=na, text="WMRP",
                 text_size=size.normal, text_color=#C57A00,
                 text_halign=text.align_left, text_valign=text.align_center,
                 text_wrap=text.wrap_none, text_formatting=text.format_bold)
        box.set_lefttop(wmrp_name_backup, bar_index, wmrp + text_half_height)
        box.set_rightbottom(wmrp_name_backup, bar_index + 12, wmrp - text_half_height)
    else
        label.delete(wmrp_name)
        wmrp_name := na
        box.delete(wmrp_name_backup)
        wmrp_name_backup := na
