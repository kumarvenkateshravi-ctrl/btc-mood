//@version=6
indicator(title="BTC Whale Hunter's Institutional Signal Diagnostic V2", shorttitle="Whale Signal Diag V2", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// Adaptive Demand & Supply Zones (ADSZ)
//
// ATR-based volatility zones that work universally on any asset and timeframe.
// Plots demand/supply zones across the three fixed display timeframes (4H,
// Daily, Weekly) using statistical volatility derived from Average True Range.
// Zones auto-adapt — wider during high volatility, tighter during calm periods.
//
// Core formula:
//   • Effective Volatility = ATR Slope × Annualized ATR%
//   • Zone spread (σ) simplifies to: σ = Slope × ATR
//   • Strong zones at ±1σ from open, Weak zones at ±σ/2.83 (or σ/2.77)
//   • 3 fixed display layers — 4H primary, Daily confirmation, Weekly confirmation
//   • Independent zone visibility toggles for all three fixed layers
//
// Works on time-based charts of 4H or lower for Stocks, Indices, Crypto,
// Commodities, and Forex.
// ══════════════════════════════════════════════════════════════════════════════

// ── INPUTS ───────────────────────────────────────────────────────────────────

// Frozen zone calibration — intentionally not exposed in Inputs
// These are the original defaults and cannot be changed from indicator settings.
const int   d_atr_period  = 20
const float d_slope       = 0.69
const float d_intercept   = 0.0
const int   w_atr_period  = 5
const float w_slope       = 0.68
const float w_intercept   = 0.0
const int   h4_atr_period = 20
const float h4_slope      = 0.92

grp_layers = "── Fixed Zone Layers ──"
bool show_l1_zones = input.bool(true, title="Show Layer 1 — 4H Zones", group=grp_layers)
bool show_l2_zones = input.bool(true, title="Show Layer 2 — Daily Zones", group=grp_layers)
bool show_l3_zones = input.bool(true, title="Show Layer 3 — Weekly Zones", group=grp_layers)

// This display needs chart bars of 4H or less to represent each 4H period.
if timeframe.in_seconds() > timeframe.in_seconds("240")
    runtime.error("Use a time-based chart of 4 hours or lower for the 4H zones and POC display.")

// ── CONSTANTS ────────────────────────────────────────────────────────────────

float phi     = 1.618034
float sqrt2   = math.sqrt(2)
float sqrt252 = math.sqrt(252)

// Ensure sufficient history for higher-timeframe zone calculations
max_bars_back(time,   5000)
max_bars_back(open,   5000)
max_bars_back(high,   5000)
max_bars_back(low,    5000)
max_bars_back(close,  5000)

// ── DAILY ZONES ──────────────────────────────────────────────────────────────

[day_open, day_atr, day_close_prev] = request.security(syminfo.tickerid, "D", [open, ta.atr(d_atr_period)[1], close[1]], lookahead=barmerge.lookahead_on)

// Effective Volatility from annualized ATR%
float atr_ann_pct = day_atr / day_close_prev * sqrt252 * 100
// float atr_ann_pct = day_atr / day_open * sqrt252 * 100          // ← Gap fix: uncomment this, comment line above
float effvol      = d_slope * atr_ann_pct + d_intercept

// Zone geometry
float P          = math.round(day_open)
float sigma      = P * effvol / (100.0 * sqrt252)
float dist_strong = sigma
float dist_weak   = sigma / (2.0 * sqrt2)
float ws          = math.round(sigma / 4.0)
float ww          = math.round(sigma / (4.0 * phi))

// Daily zone boundaries
float sd_low   = math.round(P - dist_strong - ws / 2)
float sd_high  = math.round(P - dist_strong + ws / 2)
float wd_low   = math.round(P - dist_weak   - ww / 2)
float wd_high  = math.round(P - dist_weak   + ww / 2)
float wsp_low  = math.round(P + dist_weak   - ww / 2)
float wsp_high = math.round(P + dist_weak   + ww / 2)
float ss_low   = math.round(P + dist_strong - ws / 2)
float ss_high  = math.round(P + dist_strong + ws / 2)

// ── WEEKLY ZONES ─────────────────────────────────────────────────────────────

[week_open, w_atr_weekly, w_close_prev] = request.security(syminfo.tickerid, "W", [open, ta.atr(w_atr_period)[1], close[1]], lookahead=barmerge.lookahead_on)

// Weekly Effective Volatility
float w_atr_ann_pct = w_atr_weekly / w_close_prev * math.sqrt(52) * 100
// float w_atr_ann_pct = w_atr_weekly / week_open * math.sqrt(52) * 100  // ← Gap fix: uncomment this, comment line above

var float effvol_w = na
bool new_week = ta.change(time("W")) != 0
if new_week
    effvol_w := w_slope * w_atr_ann_pct + w_intercept
if na(effvol_w)
    effvol_w := w_slope * w_atr_ann_pct + w_intercept

float P_w          = math.round(week_open)
float sigma_w      = P_w * effvol_w / (100.0 * math.sqrt(252.0 / 5.0))
float dist_strong_w = sigma_w
float dist_weak_w   = sigma_w / (2.0 * sqrt2)
float ws_w          = math.round(sigma_w / 4.0)
float ww_w          = math.round(sigma_w / (4.0 * phi))

// Weekly zone boundaries
float wsd_low  = math.round(P_w - dist_strong_w - ws_w / 2)
float wsd_high = math.round(P_w - dist_strong_w + ws_w / 2)
float wwd_low  = math.round(P_w - dist_weak_w   - ww_w / 2)
float wwd_high = math.round(P_w - dist_weak_w   + ww_w / 2)
float wws_low  = math.round(P_w + dist_weak_w   - ww_w / 2)
float wws_high = math.round(P_w + dist_weak_w   + ww_w / 2)
float wss_low  = math.round(P_w + dist_strong_w - ws_w / 2)
float wss_high = math.round(P_w + dist_strong_w + ws_w / 2)

// ── 4H ZONES ─────────────────────────────────────────────────────────────────

[h4_open, h4_atr] = request.security(syminfo.tickerid, "240", [open, ta.atr(h4_atr_period)[1]], lookahead=barmerge.lookahead_on)

// 4H Effective Volatility (normalize by h4_open to handle overnight gaps)
float h4_atr_ann_pct = h4_atr / h4_open * math.sqrt(504) * 100

var float effvol_4h = na
bool new_4h = ta.change(time("240")) != 0
if new_4h
    effvol_4h := h4_slope * h4_atr_ann_pct
if na(effvol_4h)
    effvol_4h := h4_slope * h4_atr_ann_pct

float P_4h          = math.round(h4_open)
float sigma_4h      = P_4h * effvol_4h / (100.0 * math.sqrt(504.0))
float dist_strong_4h = sigma_4h
float dist_weak_4h   = sigma_4h / 2.77
float ws_4h          = math.round(sigma_4h / 4.35)
float ww_4h          = math.round(sigma_4h / 5.1)

// 4H zone boundaries
float h4sd_low  = math.round(P_4h - dist_strong_4h - ws_4h / 2)
float h4sd_high = math.round(P_4h - dist_strong_4h + ws_4h / 2)
float h4wd_low  = math.round(P_4h - dist_weak_4h   - ww_4h / 2)
float h4wd_high = math.round(P_4h - dist_weak_4h   + ww_4h / 2)
float h4ws_low  = math.round(P_4h + dist_weak_4h   - ww_4h / 2)
float h4ws_high = math.round(P_4h + dist_weak_4h   + ww_4h / 2)
float h4ss_low  = math.round(P_4h + dist_strong_4h - ws_4h / 2)
float h4ss_high = math.round(P_4h + dist_strong_4h + ws_4h / 2)


// ── ZONE DISPLAY (3 Fixed Layers) ───────────────────────────────────────────
// Fixed layers map 4H, Daily and Weekly to the pre-computed zone boundaries.
// All plot colors use literal choices; no runtime color calculations suppress
// TradingView Style-tab color selectors.
// Layer 1 (4H): Green demand / Orange-Red supply
// Layer 2 (Daily): Cyan/Teal demand / Magenta/Crimson supply
// Layer 3 (Weekly): Blue demand / Purple supply

// Layer 1 — zone boundaries (hidden when show_l1_zones is off)
float l1_sd_l = show_l1_zones ? h4sd_low : na
float l1_sd_h = show_l1_zones ? h4sd_high : na
float l1_wd_l = show_l1_zones ? h4wd_low : na
float l1_wd_h = show_l1_zones ? h4wd_high : na
float l1_ws_l = show_l1_zones ? h4ws_low : na
float l1_ws_h = show_l1_zones ? h4ws_high : na
float l1_ss_l = show_l1_zones ? h4ss_low : na
float l1_ss_h = show_l1_zones ? h4ss_high : na


// Layer 1: stepped boundaries activate on the exact first bar of each 4H block.
zone_l1_sd_lower = plot(l1_sd_l, title="4H — Strong Demand Lower", color=#388E3C, linewidth=1, style=plot.style_stepline, editable=true)
zone_l1_sd_upper = plot(l1_sd_h, title="4H — Strong Demand Upper", color=#388E3C, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l1_sd_lower, zone_l1_sd_upper, color=color.new(#388E3C,75), title="4H — Strong Demand Background", fillgaps=false, editable=true)
zone_l1_wd_lower = plot(l1_wd_l, title="4H — Weak Demand Lower", color=#76B852, linewidth=1, style=plot.style_stepline, editable=true)
zone_l1_wd_upper = plot(l1_wd_h, title="4H — Weak Demand Upper", color=#76B852, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l1_wd_lower, zone_l1_wd_upper, color=color.new(#76B852,82), title="4H — Weak Demand Background", fillgaps=false, editable=true)
zone_l1_ws_lower = plot(l1_ws_l, title="4H — Weak Supply Lower", color=#FB8C00, linewidth=1, style=plot.style_stepline, editable=true)
zone_l1_ws_upper = plot(l1_ws_h, title="4H — Weak Supply Upper", color=#FB8C00, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l1_ws_lower, zone_l1_ws_upper, color=color.new(#FB8C00,82), title="4H — Weak Supply Background", fillgaps=false, editable=true)
zone_l1_ss_lower = plot(l1_ss_l, title="4H — Strong Supply Lower", color=#E53935, linewidth=1, style=plot.style_stepline, editable=true)
zone_l1_ss_upper = plot(l1_ss_h, title="4H — Strong Supply Upper", color=#E53935, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l1_ss_lower, zone_l1_ss_upper, color=color.new(#E53935,75), title="4H — Strong Supply Background", fillgaps=false, editable=true)


// Layer 2 — zone boundaries (hidden when show_l2_zones is off)
float l2_sd_l = show_l2_zones ? sd_low : na
float l2_sd_h = show_l2_zones ? sd_high : na
float l2_wd_l = show_l2_zones ? wd_low : na
float l2_wd_h = show_l2_zones ? wd_high : na
float l2_ws_l = show_l2_zones ? wsp_low : na
float l2_ws_h = show_l2_zones ? wsp_high : na
float l2_ss_l = show_l2_zones ? ss_low : na
float l2_ss_h = show_l2_zones ? ss_high : na

// Plot Layer 2 (cyan demand and magenta supply)
zone_l2_sd_lower = plot(l2_sd_l, title="Daily — Strong Demand Lower", color=#00838F, linewidth=1, style=plot.style_stepline, editable=true)
zone_l2_sd_upper = plot(l2_sd_h, title="Daily — Strong Demand Upper", color=#00838F, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l2_sd_lower, zone_l2_sd_upper, color=color.new(#00838F,75), title="Daily — Strong Demand Background", fillgaps=false, editable=true)
zone_l2_wd_lower = plot(l2_wd_l, title="Daily — Weak Demand Lower", color=#00BCD4, linewidth=1, style=plot.style_stepline, editable=true)
zone_l2_wd_upper = plot(l2_wd_h, title="Daily — Weak Demand Upper", color=#00BCD4, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l2_wd_lower, zone_l2_wd_upper, color=color.new(#00BCD4,82), title="Daily — Weak Demand Background", fillgaps=false, editable=true)
zone_l2_ws_lower = plot(l2_ws_l, title="Daily — Weak Supply Lower", color=#E91E63, linewidth=1, style=plot.style_stepline, editable=true)
zone_l2_ws_upper = plot(l2_ws_h, title="Daily — Weak Supply Upper", color=#E91E63, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l2_ws_lower, zone_l2_ws_upper, color=color.new(#E91E63,82), title="Daily — Weak Supply Background", fillgaps=false, editable=true)
zone_l2_ss_lower = plot(l2_ss_l, title="Daily — Strong Supply Lower", color=#AD1457, linewidth=1, style=plot.style_stepline, editable=true)
zone_l2_ss_upper = plot(l2_ss_h, title="Daily — Strong Supply Upper", color=#AD1457, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l2_ss_lower, zone_l2_ss_upper, color=color.new(#AD1457,75), title="Daily — Strong Supply Background", fillgaps=false, editable=true)

// Layer 3 — Weekly zone boundaries
float l3_sd_l = show_l3_zones ? wsd_low : na
float l3_sd_h = show_l3_zones ? wsd_high : na
float l3_wd_l = show_l3_zones ? wwd_low : na
float l3_wd_h = show_l3_zones ? wwd_high : na
float l3_ws_l = show_l3_zones ? wws_low : na
float l3_ws_h = show_l3_zones ? wws_high : na
float l3_ss_l = show_l3_zones ? wss_low : na
float l3_ss_h = show_l3_zones ? wss_high : na

zone_l3_sd_lower = plot(l3_sd_l, title="Weekly — Strong Demand Lower", color=#1565C0, linewidth=1, style=plot.style_stepline, editable=true)
zone_l3_sd_upper = plot(l3_sd_h, title="Weekly — Strong Demand Upper", color=#1565C0, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l3_sd_lower, zone_l3_sd_upper, color=color.new(#1565C0,75), title="Weekly — Strong Demand Background", fillgaps=false, editable=true)
zone_l3_wd_lower = plot(l3_wd_l, title="Weekly — Weak Demand Lower", color=#42A5F5, linewidth=1, style=plot.style_stepline, editable=true)
zone_l3_wd_upper = plot(l3_wd_h, title="Weekly — Weak Demand Upper", color=#42A5F5, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l3_wd_lower, zone_l3_wd_upper, color=color.new(#42A5F5,82), title="Weekly — Weak Demand Background", fillgaps=false, editable=true)
zone_l3_ws_lower = plot(l3_ws_l, title="Weekly — Weak Supply Lower", color=#AB47BC, linewidth=1, style=plot.style_stepline, editable=true)
zone_l3_ws_upper = plot(l3_ws_h, title="Weekly — Weak Supply Upper", color=#AB47BC, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l3_ws_lower, zone_l3_ws_upper, color=color.new(#AB47BC,82), title="Weekly — Weak Supply Background", fillgaps=false, editable=true)
zone_l3_ss_lower = plot(l3_ss_l, title="Weekly — Strong Supply Lower", color=#6A1B9A, linewidth=1, style=plot.style_stepline, editable=true)
zone_l3_ss_upper = plot(l3_ss_h, title="Weekly — Strong Supply Upper", color=#6A1B9A, linewidth=1, style=plot.style_stepline, editable=true)
fill(zone_l3_ss_lower, zone_l3_ss_upper, color=color.new(#6A1B9A,75), title="Weekly — Strong Supply Background", fillgaps=false, editable=true)

// ── BTC WHALE HUNTER'S — POC & MRP [4H Exact Fit] ──
// Functional reconstruction from observed chart values. This is not the
// protected source code and does not use volume-profile bins.

GRP_MRP = "MRP"
GRP_POC = "POC LINES"

showMrp = input.bool(true, "Show MRP", inline = "mrp", group = GRP_MRP)
showWMrp = input.bool(true, "W MRP", inline = "mrp", group = GRP_MRP)

showWeeklyPoc = input.bool(true, "Show Weekly POC", group = GRP_POC)
showDailyPoc = input.bool(true, "Show Daily POC", group = GRP_POC)
showFourHourPoc = input.bool(true, "Show 4-Hour POC", group = GRP_POC)

weeklyPocColor = input.color(#F59E0B, "Weekly POC Color", group = GRP_POC)
dailyPocColor = input.color(#14532D, "Daily POC Color", group = GRP_POC)
fourHourPocColor = input.color(#22D3EE, "4-Hour POC Color", group = GRP_POC)
pocLineWidth = input.int(2, "POC Line Width", minval = 1, maxval = 4, group = GRP_POC)

MRP_COLOR = #0B46F0
WEEKLY_MRP_COLOR = #C57A00

const int FOUR_HOURS_MS = 4 * 60 * 60 * 1000
const int DAY_MS = 24 * 60 * 60 * 1000

int fourHourKey = int(math.floor(time / FOUR_HOURS_MS))
int dayKey = int(math.floor(time / DAY_MS))
int weekKey = int(math.floor((dayKey + 3) / 7))

bool newFourHour = barstate.isfirst or fourHourKey != fourHourKey[1]
bool newDay = barstate.isfirst or dayKey != dayKey[1]
bool newWeek = barstate.isfirst or weekKey != weekKey[1]

// Developing chart-timeframe Daily and Weekly HLC3 VWAPs.
float sourceVolume = nz(volume, 0.0)
float sourcePriceVolume = hlc3 * sourceVolume

var float dailyPv = 0.0
var float dailyVolume = 0.0
var float weeklyPv = 0.0
var float weeklyVolume = 0.0

if newDay
    dailyPv := 0.0
    dailyVolume := 0.0
if newWeek
    weeklyPv := 0.0
    weeklyVolume := 0.0

dailyPv += sourcePriceVolume
dailyVolume += sourceVolume
weeklyPv += sourcePriceVolume
weeklyVolume += sourceVolume

float whaleMrp = dailyVolume > 0 ? dailyPv / dailyVolume : na
float weeklyMrp = weeklyVolume > 0 ? weeklyPv / weeklyVolume : na

plot(showMrp ? whaleMrp : na, "MRP", color = MRP_COLOR, linewidth = 2)
plot(showWMrp ? weeklyMrp : na, "W MRP", color = WEEKLY_MRP_COLOR, linewidth = 1)

// Exact cyan reconstruction:
// Build a UTC-day VWAP from native 4H candles, using each completed 4H
// candle's HLC3 and volume. The [1] value is the cumulative 4H VWAP known at
// the opening of the current block. Therefore the historical line is stable
// and does not use the unfinished current 4H candle.
f_developingDailyVwapFrom4H() =>
    const int LOCAL_DAY_MS = 24 * 60 * 60 * 1000
    int localDayKey = int(math.floor(time / LOCAL_DAY_MS))
    bool localNewDay = barstate.isfirst or localDayKey != localDayKey[1]

    float localVolume = nz(volume, 0.0)
    var float localPvSum = 0.0
    var float localVolumeSum = 0.0

    if localNewDay
        localPvSum := 0.0
        localVolumeSum := 0.0

    localPvSum += hlc3 * localVolume
    localVolumeSum += localVolume
    localVolumeSum > 0 ? localPvSum / localVolumeSum : na

float fourHourPoc = request.security(
     syminfo.tickerid, "240", f_developingDailyVwapFrom4H()[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

// Weekly POC and confirmed prior-day pivot retained from the reconstruction.
float weeklyPoc = request.security(
     syminfo.tickerid, "1W", open,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

float dailyPoc = request.security(
     syminfo.tickerid, "1D",
     (high[1] + low[1] + close[1]) / 3,
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

color dailyPlotColor = newDay and not barstate.isfirst ? na : dailyPocColor
color weeklyPlotColor = newWeek and not barstate.isfirst ? na : weeklyPocColor

plot(showWeeklyPoc ? weeklyPoc : na, "Weekly POC", color = weeklyPlotColor, linewidth = pocLineWidth, style = plot.style_linebr)
plot(showDailyPoc ? dailyPoc : na, "Daily POC", color = dailyPlotColor, linewidth = pocLineWidth, style = plot.style_linebr)

// Keep the value in the status line and Data Window. The visible plot must be
// a time-anchored line: bar-based plots stop at the preceding 5-minute bar.
plot(showFourHourPoc ? fourHourPoc : na, "4-Hour POC", display = display.status_line + display.data_window)

// UTC 00:00/04:00/... boundaries display as 05:30/09:30/... in India.
// Each segment ends exactly where the next one starts, with no chart-bar gap.
if showFourHourPoc and newFourHour and not na(fourHourPoc)
    int blockStart = fourHourKey * FOUR_HOURS_MS
    line.new(x1 = blockStart, y1 = fourHourPoc, x2 = blockStart + FOUR_HOURS_MS, y2 = fourHourPoc, xloc = xloc.bar_time, extend = extend.none, color = fourHourPocColor, width = pocLineWidth)

// ══════════════════════════════════════════════════════════════════════════════
// TEMPORARY INSTITUTIONAL SIGNAL DIAGNOSTIC
//
// This module separates raw W/M patterns, institutional zone/volume defence,
// accumulation filtering and three-POC compression breakouts. It is meant for
// visual comparison against reference screenshots before a final signal rule
// is selected. Four-Flag logic is intentionally deferred. Confirmed labels do
// not use future data. The optional backpainted display moves a confirmed W/M
// label to the second pivot only for comparison and marks the real-time
// confirmation bar with a small "C" circle.
// ══════════════════════════════════════════════════════════════════════════════

string GRP_DIAG_PATTERN = "DIAGNOSTIC — W/M Pattern"
string GRP_DIAG_FILTERS = "DIAGNOSTIC — Filters"
string GRP_DIAG_REGIME = "DIAGNOSTIC — Market Regime"
string GRP_DIAG_COMPRESSION = "DIAGNOSTIC — POC Compression"
string GRP_DIAG_DISPLAY = "DIAGNOSTIC — Display"

bool diagEnabled = input.bool(true, "Enable temporary diagnostic", group = GRP_DIAG_PATTERN)
int diagPivotLeft = input.int(3, "Pivot bars left", minval = 1, maxval = 20, group = GRP_DIAG_PATTERN)
int diagPivotRight = input.int(3, "Pivot bars right", minval = 1, maxval = 20, group = GRP_DIAG_PATTERN,
     tooltip = "A pivot is known only after this many right-side bars have closed.")
int diagMinPivotGap = input.int(3, "Minimum bars between pivots", minval = 1, maxval = 100, group = GRP_DIAG_PATTERN)
int diagMaxPivotGap = input.int(24, "Maximum bars between pivots", minval = 2, maxval = 200, group = GRP_DIAG_PATTERN)
int diagAtrLength = input.int(14, "ATR length", minval = 1, maxval = 100, group = GRP_DIAG_PATTERN)
float diagPairToleranceAtr = input.float(0.75, "Two-pivot price tolerance (ATR)", minval = 0.05, maxval = 5.0, step = 0.05, group = GRP_DIAG_PATTERN)
string diagNecklineMode = input.string("Close", "Neckline confirmation", options = ["Close", "Wick", "Off"], group = GRP_DIAG_PATTERN,
     tooltip = "Close: candle close must break the neckline. Wick: high/low may break it. Off: confirm when the second pivot itself becomes known.")
int diagBreakoutWindow = input.int(12, "Breakout window after pivot recognition", minval = 1, maxval = 100, group = GRP_DIAG_PATTERN)
float diagInvalidationAtr = input.float(0.25, "Pattern invalidation beyond extreme (ATR)", minval = 0.0, maxval = 3.0, step = 0.05, group = GRP_DIAG_PATTERN)

string diagPocFilter = input.string("Off", "POC filter", options = ["Off", "4H only", "All three"], group = GRP_DIAG_FILTERS)
string diagMrpFilter = input.string("Off", "MRP filter", options = ["Off", "Price vs MRP", "MRP vs WMRP", "Price + relationship", "Fresh MRP cross"], group = GRP_DIAG_FILTERS)
int diagMrpCrossWindow = input.int(6, "Fresh MRP-cross window", minval = 0, maxval = 50, group = GRP_DIAG_FILTERS)
string diagInstitutionalFilter = input.string("Off", "Institutional defence filter", options = ["Off", "Zone touch", "Zone + pivot volume"], group = GRP_DIAG_FILTERS,
     tooltip = "Tests whether the W/M second pivot overlaps an existing demand/supply zone. The volume option also requires elevated volume on that pivot candle.")
string diagInstitutionalScope = input.string("Any timeframe", "Institutional zone scope", options = ["4H only", "Any timeframe", "Two or more timeframes"], group = GRP_DIAG_FILTERS)
float diagPivotVolumeMultiplier = input.float(1.20, "Pivot volume / average", minval = 0.10, maxval = 5.0, step = 0.05, group = GRP_DIAG_FILTERS)
bool diagUseWaveSlope = input.bool(false, "Require MRP/wave slope", group = GRP_DIAG_FILTERS)
int diagWaveSlopeBars = input.int(3, "MRP/wave slope lookback", minval = 1, maxval = 20, group = GRP_DIAG_FILTERS)
bool diagUseCandleConfirmation = input.bool(false, "Require directional confirmation candle", group = GRP_DIAG_FILTERS)
float diagCloseLocation = input.float(0.60, "Minimum close location in candle", minval = 0.50, maxval = 1.0, step = 0.05, group = GRP_DIAG_FILTERS)
bool diagUseVolumeExpansion = input.bool(false, "Require volume expansion", group = GRP_DIAG_FILTERS)
int diagVolumeLength = input.int(20, "Volume average length", minval = 1, maxval = 200, group = GRP_DIAG_FILTERS)
float diagVolumeMultiplier = input.float(1.00, "Minimum volume / average", minval = 0.10, maxval = 5.0, step = 0.05, group = GRP_DIAG_FILTERS)
int diagCooldownBars = input.int(3, "Qualified-signal cooldown", minval = 0, maxval = 100, group = GRP_DIAG_FILTERS)

string diagMarketPhaseFilter = input.string("Avoid accumulation", "W/M market-phase filter", options = ["Off", "Avoid accumulation", "Recent POC compression", "Compression direction"], group = GRP_DIAG_REGIME)
int diagPhaseLength = input.int(20, "Accumulation measurement length", minval = 5, maxval = 200, group = GRP_DIAG_REGIME)
float diagWideRangeAtr = input.float(4.00, "Accumulation minimum range (ATR)", minval = 0.50, maxval = 20.0, step = 0.25, group = GRP_DIAG_REGIME)
float diagMaxEfficiency = input.float(0.35, "Accumulation maximum displacement/range", minval = 0.05, maxval = 1.0, step = 0.05, group = GRP_DIAG_REGIME)

bool diagEnableCompressionEngine = input.bool(true, "Enable three-POC compression signals", group = GRP_DIAG_COMPRESSION)
float diagPocConvergenceAtr = input.float(0.35, "Maximum three-POC spread (ATR)", minval = 0.01, maxval = 3.0, step = 0.05, group = GRP_DIAG_COMPRESSION)
int diagCompressionWindow = input.int(12, "Breakout window after all-POC touch", minval = 1, maxval = 100, group = GRP_DIAG_COMPRESSION)
float diagCompressionBufferAtr = input.float(0.05, "Breakout buffer (ATR)", minval = 0.0, maxval = 2.0, step = 0.01, group = GRP_DIAG_COMPRESSION)
bool diagCompressionRequireMrp = input.bool(true, "Require MRP/WMRP direction", group = GRP_DIAG_COMPRESSION)
bool diagCompressionUseVolume = input.bool(false, "Require breakout volume expansion", group = GRP_DIAG_COMPRESSION)
float diagCompressionVolumeMultiplier = input.float(1.20, "Breakout volume / average", minval = 0.10, maxval = 5.0, step = 0.05, group = GRP_DIAG_COMPRESSION)

bool diagShowPivotMarkers = input.bool(false, "Show every confirmed pivot", group = GRP_DIAG_DISPLAY)
bool diagShowPatternMarkers = input.bool(true, "Show W2 / M2 pattern candidates", group = GRP_DIAG_DISPLAY)
bool diagShowRejected = input.bool(true, "Show candidates rejected by filters", group = GRP_DIAG_DISPLAY)
bool diagShowNecklines = input.bool(true, "Show active necklines", group = GRP_DIAG_DISPLAY)
bool diagShowCompressionEvents = input.bool(true, "Show three-POC compression events", group = GRP_DIAG_DISPLAY)
bool diagShowSignals = input.bool(true, "Show qualified BUY / SELL labels", group = GRP_DIAG_DISPLAY)
string diagSignalPlacement = input.string("Confirmation bar", "Signal label placement", options = ["Confirmation bar", "Second pivot bar (backpainted)"], group = GRP_DIAG_DISPLAY,
     tooltip = "Backpainted placement is for screenshot comparison only. The C marker shows when the signal was actually confirmed.")

float diagAtr = ta.atr(diagAtrLength)
float diagPivotLow = ta.pivotlow(low, diagPivotLeft, diagPivotRight)
float diagPivotHigh = ta.pivothigh(high, diagPivotLeft, diagPivotRight)
bool diagNewPivotLow = not na(diagPivotLow)
bool diagNewPivotHigh = not na(diagPivotHigh)

bool diagMrpCrossUp = ta.crossover(whaleMrp, weeklyMrp)
bool diagMrpCrossDown = ta.crossunder(whaleMrp, weeklyMrp)
int diagBarsSinceMrpCrossUp = ta.barssince(diagMrpCrossUp)
int diagBarsSinceMrpCrossDown = ta.barssince(diagMrpCrossDown)
float diagAverageVolume = ta.sma(volume, diagVolumeLength)

f_diagZoneOverlap(float candleLow, float candleHigh, float zoneLow, float zoneHigh) =>
    not na(zoneLow) and not na(zoneHigh) and candleLow <= zoneHigh and candleHigh >= zoneLow

// Market phase classification. "Accumulation" is represented by a wide
// multi-bar range with little net displacement. It is deliberately a filter,
// not a trade direction signal.
float diagPhaseRange = ta.highest(high, diagPhaseLength) - ta.lowest(low, diagPhaseLength)
float diagPhaseDisplacement = math.abs(close - close[diagPhaseLength])
float diagPhaseEfficiency = diagPhaseRange > 0 ? diagPhaseDisplacement / diagPhaseRange : 0.0
bool diagAccumulationPhase = not na(diagAtr) and diagPhaseRange >= diagAtr * diagWideRangeAtr and diagPhaseEfficiency <= diagMaxEfficiency

// Three-POC compression requires both tight convergence and one candle whose
// complete range spans the Weekly, Daily and 4H POCs.
float diagPocTop = math.max(weeklyPoc, math.max(dailyPoc, fourHourPoc))
float diagPocBottom = math.min(weeklyPoc, math.min(dailyPoc, fourHourPoc))
float diagPocSpread = diagPocTop - diagPocBottom
bool diagPocsReady = not na(weeklyPoc) and not na(dailyPoc) and not na(fourHourPoc) and not na(diagAtr)
bool diagPocsConverged = diagPocsReady and diagPocSpread <= diagAtr * diagPocConvergenceAtr
bool diagCandleTouchesAllPocs = diagPocsReady and low <= diagPocBottom and high >= diagPocTop
bool diagCompressionEvent = diagEnabled and barstate.isconfirmed and diagPocsConverged and diagCandleTouchesAllPocs

var bool diagCompressionArmed = false
var int diagCompressionExpiry = na
var float diagCompressionTop = na
var float diagCompressionBottom = na

if diagCompressionEvent
    diagCompressionArmed := true
    diagCompressionExpiry := bar_index + diagCompressionWindow
    diagCompressionTop := diagPocTop
    diagCompressionBottom := diagPocBottom

if diagCompressionArmed and bar_index > diagCompressionExpiry
    diagCompressionArmed := false

int diagBarsSinceCompression = ta.barssince(diagCompressionEvent)
bool diagRecentCompression = not na(diagBarsSinceCompression) and diagBarsSinceCompression <= diagCompressionWindow

// Previous confirmed pivots provide the first leg of the W or M.
var float diagPreviousLowPrice = na
var int diagPreviousLowIndex = na
var float diagPreviousHighPrice = na
var int diagPreviousHighIndex = na

// Pending patterns wait for their neckline break.
var bool diagBullPending = false
var float diagBullNeckline = na
var float diagBullInvalidation = na
var int diagBullExpiry = na
var int diagBullSecondPivotIndex = na
var float diagBullSecondPivotPrice = na
var bool diagBullZoneCandidatePass = false
var bool diagBullPivotVolumePass = false

var bool diagBearPending = false
var float diagBearNeckline = na
var float diagBearInvalidation = na
var int diagBearExpiry = na
var int diagBearSecondPivotIndex = na
var float diagBearSecondPivotPrice = na
var bool diagBearZoneCandidatePass = false
var bool diagBearPivotVolumePass = false

bool diagNewWPair = false
bool diagNewMPair = false
bool diagRawBuyConfirmation = false
bool diagRawSellConfirmation = false

if diagEnabled and diagNewPivotLow
    int currentLowIndex = bar_index - diagPivotRight
    float pivotAtr = nz(diagAtr[diagPivotRight], diagAtr)
    int lowGap = na(diagPreviousLowIndex) ? na : currentLowIndex - diagPreviousLowIndex
    bool lowGapValid = not na(lowGap) and lowGap >= diagMinPivotGap and lowGap <= diagMaxPivotGap
    bool lowPriceValid = lowGapValid and math.abs(diagPivotLow - diagPreviousLowPrice) <= pivotAtr * diagPairToleranceAtr

    if lowPriceValid
        float neckline = na
        for historyOffset = 0 to diagMaxPivotGap + diagPivotRight
            if historyOffset >= diagPivotRight and historyOffset <= diagPivotRight + lowGap
                neckline := na(neckline) ? high[historyOffset] : math.max(neckline, high[historyOffset])

        diagNewWPair := not na(neckline)
        if diagNewWPair
            bool h4DemandTouch = f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], h4sd_low[diagPivotRight], h4sd_high[diagPivotRight]) or f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], h4wd_low[diagPivotRight], h4wd_high[diagPivotRight])
            bool dailyDemandTouch = f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], sd_low[diagPivotRight], sd_high[diagPivotRight]) or f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], wd_low[diagPivotRight], wd_high[diagPivotRight])
            bool weeklyDemandTouch = f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], wsd_low[diagPivotRight], wsd_high[diagPivotRight]) or f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], wwd_low[diagPivotRight], wwd_high[diagPivotRight])
            int demandTouchCount = (h4DemandTouch ? 1 : 0) + (dailyDemandTouch ? 1 : 0) + (weeklyDemandTouch ? 1 : 0)
            diagBullZoneCandidatePass := switch diagInstitutionalScope
                "4H only" => h4DemandTouch
                "Two or more timeframes" => demandTouchCount >= 2
                => demandTouchCount >= 1
            float pivotAverageVolume = diagAverageVolume[diagPivotRight]
            diagBullPivotVolumePass := not na(pivotAverageVolume) and pivotAverageVolume > 0 and volume[diagPivotRight] >= pivotAverageVolume * diagPivotVolumeMultiplier
            diagBullSecondPivotIndex := currentLowIndex
            diagBullSecondPivotPrice := diagPivotLow
            diagBullNeckline := neckline
            diagBullInvalidation := math.min(diagPreviousLowPrice, diagPivotLow) - pivotAtr * diagInvalidationAtr
            diagBullExpiry := bar_index + diagBreakoutWindow
            diagBullPending := diagNecklineMode != "Off"
            if diagNecklineMode == "Off"
                diagRawBuyConfirmation := true

    diagPreviousLowPrice := diagPivotLow
    diagPreviousLowIndex := currentLowIndex

if diagEnabled and diagNewPivotHigh
    int currentHighIndex = bar_index - diagPivotRight
    float pivotAtr = nz(diagAtr[diagPivotRight], diagAtr)
    int highGap = na(diagPreviousHighIndex) ? na : currentHighIndex - diagPreviousHighIndex
    bool highGapValid = not na(highGap) and highGap >= diagMinPivotGap and highGap <= diagMaxPivotGap
    bool highPriceValid = highGapValid and math.abs(diagPivotHigh - diagPreviousHighPrice) <= pivotAtr * diagPairToleranceAtr

    if highPriceValid
        float neckline = na
        for historyOffset = 0 to diagMaxPivotGap + diagPivotRight
            if historyOffset >= diagPivotRight and historyOffset <= diagPivotRight + highGap
                neckline := na(neckline) ? low[historyOffset] : math.min(neckline, low[historyOffset])

        diagNewMPair := not na(neckline)
        if diagNewMPair
            bool h4SupplyTouch = f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], h4ws_low[diagPivotRight], h4ws_high[diagPivotRight]) or f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], h4ss_low[diagPivotRight], h4ss_high[diagPivotRight])
            bool dailySupplyTouch = f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], wsp_low[diagPivotRight], wsp_high[diagPivotRight]) or f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], ss_low[diagPivotRight], ss_high[diagPivotRight])
            bool weeklySupplyTouch = f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], wws_low[diagPivotRight], wws_high[diagPivotRight]) or f_diagZoneOverlap(low[diagPivotRight], high[diagPivotRight], wss_low[diagPivotRight], wss_high[diagPivotRight])
            int supplyTouchCount = (h4SupplyTouch ? 1 : 0) + (dailySupplyTouch ? 1 : 0) + (weeklySupplyTouch ? 1 : 0)
            diagBearZoneCandidatePass := switch diagInstitutionalScope
                "4H only" => h4SupplyTouch
                "Two or more timeframes" => supplyTouchCount >= 2
                => supplyTouchCount >= 1
            float pivotAverageVolume = diagAverageVolume[diagPivotRight]
            diagBearPivotVolumePass := not na(pivotAverageVolume) and pivotAverageVolume > 0 and volume[diagPivotRight] >= pivotAverageVolume * diagPivotVolumeMultiplier
            diagBearSecondPivotIndex := currentHighIndex
            diagBearSecondPivotPrice := diagPivotHigh
            diagBearNeckline := neckline
            diagBearInvalidation := math.max(diagPreviousHighPrice, diagPivotHigh) + pivotAtr * diagInvalidationAtr
            diagBearExpiry := bar_index + diagBreakoutWindow
            diagBearPending := diagNecklineMode != "Off"
            if diagNecklineMode == "Off"
                diagRawSellConfirmation := true

    diagPreviousHighPrice := diagPivotHigh
    diagPreviousHighIndex := currentHighIndex

// Invalidate or expire a pattern before checking its breakout.
if diagBullPending and (bar_index > diagBullExpiry or low < diagBullInvalidation)
    diagBullPending := false
if diagBearPending and (bar_index > diagBearExpiry or high > diagBearInvalidation)
    diagBearPending := false

bool diagBullNecklineBroken = diagNecklineMode == "Close" ? close > diagBullNeckline : high > diagBullNeckline
bool diagBearNecklineBroken = diagNecklineMode == "Close" ? close < diagBearNeckline : low < diagBearNeckline

if diagEnabled and barstate.isconfirmed and diagBullPending and diagBullNecklineBroken
    diagRawBuyConfirmation := true
    diagBullPending := false
if diagEnabled and barstate.isconfirmed and diagBearPending and diagBearNecklineBroken
    diagRawSellConfirmation := true
    diagBearPending := false

// Independent filters. Keeping these separate lets the Data Window show which
// condition rejected a visually valid W or M candidate.
bool diagBullPocPass = switch diagPocFilter
    "4H only" => close > fourHourPoc
    "All three" => close > fourHourPoc and close > dailyPoc and close > weeklyPoc
    => true

bool diagBearPocPass = switch diagPocFilter
    "4H only" => close < fourHourPoc
    "All three" => close < fourHourPoc and close < dailyPoc and close < weeklyPoc
    => true

bool diagRecentMrpCrossUp = not na(diagBarsSinceMrpCrossUp) and diagBarsSinceMrpCrossUp <= diagMrpCrossWindow
bool diagRecentMrpCrossDown = not na(diagBarsSinceMrpCrossDown) and diagBarsSinceMrpCrossDown <= diagMrpCrossWindow

bool diagBullMrpPass = switch diagMrpFilter
    "Price vs MRP" => close > whaleMrp
    "MRP vs WMRP" => whaleMrp > weeklyMrp
    "Price + relationship" => close > whaleMrp and whaleMrp > weeklyMrp
    "Fresh MRP cross" => diagRecentMrpCrossUp
    => true

bool diagBearMrpPass = switch diagMrpFilter
    "Price vs MRP" => close < whaleMrp
    "MRP vs WMRP" => whaleMrp < weeklyMrp
    "Price + relationship" => close < whaleMrp and whaleMrp < weeklyMrp
    "Fresh MRP cross" => diagRecentMrpCrossDown
    => true

bool diagBullInstitutionalPass = switch diagInstitutionalFilter
    "Zone touch" => diagBullZoneCandidatePass
    "Zone + pivot volume" => diagBullZoneCandidatePass and diagBullPivotVolumePass
    => true

bool diagBearInstitutionalPass = switch diagInstitutionalFilter
    "Zone touch" => diagBearZoneCandidatePass
    "Zone + pivot volume" => diagBearZoneCandidatePass and diagBearPivotVolumePass
    => true

bool diagBullPhasePass = switch diagMarketPhaseFilter
    "Avoid accumulation" => not diagAccumulationPhase
    "Recent POC compression" => diagRecentCompression
    "Compression direction" => diagRecentCompression and close > diagCompressionTop
    => true

bool diagBearPhasePass = switch diagMarketPhaseFilter
    "Avoid accumulation" => not diagAccumulationPhase
    "Recent POC compression" => diagRecentCompression
    "Compression direction" => diagRecentCompression and close < diagCompressionBottom
    => true

bool diagBullWavePass = not diagUseWaveSlope or (close > whaleMrp and whaleMrp > whaleMrp[diagWaveSlopeBars])
bool diagBearWavePass = not diagUseWaveSlope or (close < whaleMrp and whaleMrp < whaleMrp[diagWaveSlopeBars])

float diagCandleRange = math.max(high - low, syminfo.mintick)
bool diagBullCandlePass = not diagUseCandleConfirmation or (close > open and close >= low + diagCandleRange * diagCloseLocation)
bool diagBearCandlePass = not diagUseCandleConfirmation or (close < open and close <= high - diagCandleRange * diagCloseLocation)
bool diagVolumePass = not diagUseVolumeExpansion or (not na(diagAverageVolume) and volume >= diagAverageVolume * diagVolumeMultiplier)

bool diagBullFiltersPass = diagBullPocPass and diagBullMrpPass and diagBullInstitutionalPass and diagBullPhasePass and diagBullWavePass and diagBullCandlePass and diagVolumePass
bool diagBearFiltersPass = diagBearPocPass and diagBearMrpPass and diagBearInstitutionalPass and diagBearPhasePass and diagBearWavePass and diagBearCandlePass and diagVolumePass

// A separate signal engine for the all-POC compression setup. The compression
// candle arms a fixed range; the first qualified close outside that range sets
// the direction. It does not require a W or M pattern.
float diagCompressionBreakoutBuffer = diagAtr * diagCompressionBufferAtr
bool diagCompressionMrpBuyPass = not diagCompressionRequireMrp or whaleMrp > weeklyMrp
bool diagCompressionMrpSellPass = not diagCompressionRequireMrp or whaleMrp < weeklyMrp
bool diagCompressionBreakoutVolumePass = not diagCompressionUseVolume or (not na(diagAverageVolume) and diagAverageVolume > 0 and volume >= diagAverageVolume * diagCompressionVolumeMultiplier)
bool diagRawCompressionBuy = diagEnabled and diagEnableCompressionEngine and barstate.isconfirmed and diagCompressionArmed and close > diagCompressionTop + diagCompressionBreakoutBuffer and diagCompressionMrpBuyPass and diagCompressionBreakoutVolumePass
bool diagRawCompressionSell = diagEnabled and diagEnableCompressionEngine and barstate.isconfirmed and diagCompressionArmed and close < diagCompressionBottom - diagCompressionBreakoutBuffer and diagCompressionMrpSellPass and diagCompressionBreakoutVolumePass

if diagRawCompressionBuy or diagRawCompressionSell
    diagCompressionArmed := false

var int diagLastQualifiedSignalBar = na
bool diagCooldownPass = na(diagLastQualifiedSignalBar) or bar_index - diagLastQualifiedSignalBar > diagCooldownBars
bool diagBuySignal = diagEnabled and barstate.isconfirmed and diagRawBuyConfirmation and diagBullFiltersPass and diagCooldownPass
bool diagCompressionBuySignal = diagRawCompressionBuy and diagCooldownPass and not diagBuySignal
bool diagSellSignal = diagEnabled and barstate.isconfirmed and diagRawSellConfirmation and diagBearFiltersPass and diagCooldownPass and not diagBuySignal and not diagCompressionBuySignal
bool diagCompressionSellSignal = diagRawCompressionSell and diagCooldownPass and not diagBuySignal and not diagCompressionBuySignal and not diagSellSignal
bool diagRejectedBuy = diagEnabled and diagRawBuyConfirmation and not diagBullFiltersPass
bool diagRejectedSell = diagEnabled and diagRawSellConfirmation and not diagBearFiltersPass
bool diagCooldownBuy = diagEnabled and diagRawBuyConfirmation and diagBullFiltersPass and not diagCooldownPass
bool diagCooldownSell = diagEnabled and diagRawSellConfirmation and diagBearFiltersPass and not diagCooldownPass
bool diagSuppressedBuy = diagRejectedBuy or diagCooldownBuy
bool diagSuppressedSell = diagRejectedSell or diagCooldownSell

if diagBuySignal or diagCompressionBuySignal or diagSellSignal or diagCompressionSellSignal
    diagLastQualifiedSignalBar := bar_index

bool diagBackpaintLabels = diagSignalPlacement == "Second pivot bar (backpainted)"

if diagShowSignals and diagBuySignal
    int buyLabelIndex = diagBackpaintLabels ? diagBullSecondPivotIndex : bar_index
    float buyLabelPrice = diagBackpaintLabels ? diagBullSecondPivotPrice : low
    label.new(buyLabelIndex, buyLabelPrice, "BUY", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_label_up, color = #16A34A, textcolor = color.white, size = size.tiny,
         tooltip = diagBackpaintLabels ? "Backpainted to W second pivot. Confirmed on the C marker." : "Confirmed W-pattern BUY")

if diagShowSignals and diagSellSignal
    int sellLabelIndex = diagBackpaintLabels ? diagBearSecondPivotIndex : bar_index
    float sellLabelPrice = diagBackpaintLabels ? diagBearSecondPivotPrice : high
    label.new(sellLabelIndex, sellLabelPrice, "SELL", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_label_down, color = #DC2626, textcolor = color.white, size = size.tiny,
         tooltip = diagBackpaintLabels ? "Backpainted to M second pivot. Confirmed on the C marker." : "Confirmed M-pattern SELL")

if diagShowSignals and diagCompressionBuySignal
    label.new(bar_index, low, "BUY-C", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_label_up, color = #047857, textcolor = color.white, size = size.tiny,
         tooltip = "Three-POC compression breakout BUY")

if diagShowSignals and diagCompressionSellSignal
    label.new(bar_index, high, "SELL-C", xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_label_down, color = #B91C1C, textcolor = color.white, size = size.tiny,
         tooltip = "Three-POC compression breakout SELL")

// Small pivot and candidate markers are diagnostic evidence, not entries.
plotshape(diagEnabled and diagShowPivotMarkers and diagNewPivotLow, title = "DIAG Confirmed Pivot Low", style = shape.circle, location = location.belowbar, offset = -diagPivotRight, color = #22D3EE, size = size.tiny)
plotshape(diagEnabled and diagShowPivotMarkers and diagNewPivotHigh, title = "DIAG Confirmed Pivot High", style = shape.circle, location = location.abovebar, offset = -diagPivotRight, color = #F59E0B, size = size.tiny)
plotshape(diagEnabled and diagShowPatternMarkers and diagNewWPair, title = "DIAG W Second Pivot", style = shape.diamond, location = location.belowbar, offset = -diagPivotRight, color = #4ADE80, text = "W2", textcolor = color.black, size = size.tiny)
plotshape(diagEnabled and diagShowPatternMarkers and diagNewMPair, title = "DIAG M Second Pivot", style = shape.diamond, location = location.abovebar, offset = -diagPivotRight, color = #FB7185, text = "M2", textcolor = color.black, size = size.tiny)
plotshape(diagShowCompressionEvents and diagCompressionEvent, title = "DIAG Three-POC Compression", style = shape.diamond, location = location.belowbar, color = #A855F7, text = "POC3", textcolor = color.white, size = size.tiny)
plotshape(diagShowRejected and diagSuppressedBuy, title = "DIAG Suppressed BUY", style = shape.xcross, location = location.belowbar, color = diagCooldownBuy ? #FBBF24 : #9CA3AF, text = "X", textcolor = color.white, size = size.tiny)
plotshape(diagShowRejected and diagSuppressedSell, title = "DIAG Suppressed SELL", style = shape.xcross, location = location.abovebar, color = diagCooldownSell ? #FBBF24 : #9CA3AF, text = "X", textcolor = color.white, size = size.tiny)
plotshape(diagShowSignals and diagBackpaintLabels and diagBuySignal, title = "DIAG BUY Confirmation Bar", style = shape.circle, location = location.belowbar, color = #16A34A, text = "C", textcolor = color.white, size = size.tiny)
plotshape(diagShowSignals and diagBackpaintLabels and diagSellSignal, title = "DIAG SELL Confirmation Bar", style = shape.circle, location = location.abovebar, color = #DC2626, text = "C", textcolor = color.white, size = size.tiny)

plot(diagEnabled and diagShowNecklines and diagBullPending ? diagBullNeckline : na, "DIAG Active W Neckline", color = #22C55E, linewidth = 1, style = plot.style_linebr)
plot(diagEnabled and diagShowNecklines and diagBearPending ? diagBearNeckline : na, "DIAG Active M Neckline", color = #EF4444, linewidth = 1, style = plot.style_linebr)

// Numeric diagnostics remain available in TradingView's Data Window without
// adding a pane or permanent labels to the chart.
plot(diagEnabled ? (diagBullPocPass ? 1 : 0) : na, "DIAG Bull POC Pass", display = display.data_window)
plot(diagEnabled ? (diagBearPocPass ? 1 : 0) : na, "DIAG Bear POC Pass", display = display.data_window)
plot(diagEnabled ? (diagBullMrpPass ? 1 : 0) : na, "DIAG Bull MRP Pass", display = display.data_window)
plot(diagEnabled ? (diagBearMrpPass ? 1 : 0) : na, "DIAG Bear MRP Pass", display = display.data_window)
plot(diagEnabled ? (diagBullInstitutionalPass ? 1 : 0) : na, "DIAG Bull Institutional Pass", display = display.data_window)
plot(diagEnabled ? (diagBearInstitutionalPass ? 1 : 0) : na, "DIAG Bear Institutional Pass", display = display.data_window)
plot(diagEnabled ? (diagBullPhasePass ? 1 : 0) : na, "DIAG Bull Phase Pass", display = display.data_window)
plot(diagEnabled ? (diagBearPhasePass ? 1 : 0) : na, "DIAG Bear Phase Pass", display = display.data_window)
plot(diagEnabled ? (diagBullWavePass ? 1 : 0) : na, "DIAG Bull Wave Pass", display = display.data_window)
plot(diagEnabled ? (diagBearWavePass ? 1 : 0) : na, "DIAG Bear Wave Pass", display = display.data_window)
plot(diagEnabled ? (diagVolumePass ? 1 : 0) : na, "DIAG Volume Pass", display = display.data_window)
plot(diagEnabled ? (diagAccumulationPhase ? 1 : 0) : na, "DIAG Accumulation Phase", display = display.data_window)
plot(diagEnabled ? (diagCompressionArmed ? 1 : 0) : na, "DIAG Compression Armed", display = display.data_window)

alertcondition(diagBuySignal or diagCompressionBuySignal, "DIAG Qualified BUY", "Qualified diagnostic BUY on {{ticker}} {{interval}} at {{close}}")
alertcondition(diagSellSignal or diagCompressionSellSignal, "DIAG Qualified SELL", "Qualified diagnostic SELL on {{ticker}} {{interval}} at {{close}}")
