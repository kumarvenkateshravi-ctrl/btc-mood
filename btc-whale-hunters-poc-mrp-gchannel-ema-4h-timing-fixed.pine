//@version=6
indicator("BTC WHALE HUNTER'S - POC, MRP, G-Channel & EMA [Exact 4H Timing]", shorttitle = "POC/MRP + G + EMA", overlay = true, format = format.price, precision = 2, max_bars_back = 5000, max_labels_count = 50)

// Functional reconstruction from observed chart values. This is not the
// protected source code and does not use volume-profile bins.

GRP_MRP = "MRP"
GRP_POC = "POC LINES"
GRP_GCHANNEL = "G-CHANNEL TREND"
GRP_EMA = "EMA"

showMrp = input.bool(true, "Show MRP", inline = "mrp", group = GRP_MRP)
showWMrp = input.bool(true, "W MRP", inline = "mrp", group = GRP_MRP)
showMrpEndLabels = input.bool(true, "Show MRP / WMRP End Labels", group = GRP_MRP)
mrpLabelOffset = input.int(2, "End Label Offset", minval = 0, maxval = 25, group = GRP_MRP)
mrpLabelColor = input.color(#0B46F0, "MRP Label Color", inline = "label_colors", group = GRP_MRP)
wmrpLabelColor = input.color(#C57A00, "WMRP Label Color", inline = "label_colors", group = GRP_MRP)

showWeeklyPoc = input.bool(true, "Show Weekly POC", group = GRP_POC)
showDailyPoc = input.bool(true, "Show Daily POC", group = GRP_POC)
showFourHourPoc = input.bool(true, "Show 4-Hour POC", group = GRP_POC)

gLength = input.int(100, "Length", minval = 1, group = GRP_GCHANNEL)
gSource = input.source(close, "Source", group = GRP_GCHANNEL)
showGChannel = input.bool(true, "Show G-Channel Cloud", group = GRP_GCHANNEL)
showGSignals = input.bool(true, "Show G-Channel Buy/Sell", group = GRP_GCHANNEL)

showEma200 = input.bool(true, "Show EMA 200", group = GRP_EMA)
emaSource = input.source(close, "EMA Source", group = GRP_EMA)
emaLabelOffset = input.int(2, "EMA Label Offset", minval = 0, maxval = 25, group = GRP_EMA)
emaLabelColor = input.color(#FFFFFF, "EMA Label Color", group = GRP_EMA)

const int FOUR_HOURS_MS = 4 * 60 * 60 * 1000
const int DAY_MS = 24 * 60 * 60 * 1000

// Unix timestamps are UTC. These keys therefore create exact UTC blocks:
// 00:00-04:00, 04:00-08:00, etc., displayed in IST as 05:30-09:30,
// 09:30-13:30, 13:30-17:30, and so on.
int fourHourKey = int(math.floor(time / FOUR_HOURS_MS))
int dayKey = int(math.floor(time / DAY_MS))
int weekKey = int(math.floor((dayKey + 3) / 7))

bool newFourHour = barstate.isfirst or fourHourKey != fourHourKey[1]
bool newDay = barstate.isfirst or dayKey != dayKey[1]
bool newWeek = barstate.isfirst or weekKey != weekKey[1]

float sourceVolume = nz(volume, 0.0)
float sourcePriceVolume = hlc3 * sourceVolume

var float dailyPv = 0.0
var float dailyVolume = 0.0
var float weeklyPv = 0.0
var float weeklyVolume = 0.0

if newDay
    dailyPv := 0.0
    dailyVolume := 0.0
if newWeek
    weeklyPv := 0.0
    weeklyVolume := 0.0

dailyPv += sourcePriceVolume
dailyVolume += sourceVolume
weeklyPv += sourcePriceVolume
weeklyVolume += sourceVolume

float mrp = dailyVolume > 0 ? dailyPv / dailyVolume : na
float weeklyMrp = weeklyVolume > 0 ? weeklyPv / weeklyVolume : na
float ema200 = ta.ema(emaSource, 200)

plot(showMrp ? mrp : na, "MRP", color = #0B46F0, linewidth = 2, editable = true)
plot(showWMrp ? weeklyMrp : na, "W MRP", color = #C57A00, linewidth = 1, editable = true)
plot(showEma200 ? ema200 : na, "EMA 200", color = #FFFFFF, linewidth = 2, editable = true)

var label mrpEndLabel = na
var label wmrpEndLabel = na
var label emaEndLabel = na
if barstate.islast
    label.delete(mrpEndLabel)
    label.delete(wmrpEndLabel)
    label.delete(emaEndLabel)
    mrpEndLabel := na
    wmrpEndLabel := na
    emaEndLabel := na
    if showMrpEndLabels and showMrp and not na(mrp)
        mrpEndLabel := label.new(bar_index + mrpLabelOffset, mrp, "𝗠𝗥𝗣", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = mrpLabelColor, size = size.normal)
    if showMrpEndLabels and showWMrp and not na(weeklyMrp)
        wmrpEndLabel := label.new(bar_index + mrpLabelOffset, weeklyMrp, "𝗪𝗠𝗥𝗣", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = wmrpLabelColor, size = size.normal)
    if showEma200 and not na(ema200)
        emaEndLabel := label.new(bar_index + emaLabelOffset, ema200, "𝗘𝗠𝗔", xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = emaLabelColor, size = size.normal)

f_developingDailyVwapFrom4H() =>
    const int LOCAL_DAY_MS = 24 * 60 * 60 * 1000
    int localDayKey = int(math.floor(time / LOCAL_DAY_MS))
    bool localNewDay = barstate.isfirst or localDayKey != localDayKey[1]
    float localVolume = nz(volume, 0.0)
    var float localPvSum = 0.0
    var float localVolumeSum = 0.0
    if localNewDay
        localPvSum := 0.0
        localVolumeSum := 0.0
    localPvSum += hlc3 * localVolume
    localVolumeSum += localVolume
    localVolumeSum > 0 ? localPvSum / localVolumeSum : na

// [1] holds the completed native 4H value at the opening of the next block.
float fourHourPoc = request.security(syminfo.tickerid, "240", f_developingDailyVwapFrom4H()[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float weeklyPoc = request.security(syminfo.tickerid, "1W", open, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float dailyPoc = request.security(syminfo.tickerid, "1D", (high[1] + low[1] + close[1]) / 3, gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

// Daily and weekly plots retain their existing visual breaks.
float weeklyPocPlot = showWeeklyPoc and not (newWeek and not barstate.isfirst) ? weeklyPoc : na
float dailyPocPlot = showDailyPoc and not (newDay and not barstate.isfirst) ? dailyPoc : na

plot(weeklyPocPlot, "Weekly POC", color = #F59E0B, linewidth = 2, style = plot.style_linebr, editable = true)
plot(dailyPocPlot, "Daily POC", color = #14532D, linewidth = 2, style = plot.style_linebr, editable = true)

// Do not hide the 4H boundary candle. A step plot switches at exactly 00:00,
// 04:00, 08:00 UTC — 05:30, 09:30, 13:30 IST. This fixes the former
// 05:45-09:15 appearance on a 15-minute chart.
plot(showFourHourPoc ? fourHourPoc : na, "4-Hour POC", color = #22D3EE, linewidth = 2, style = plot.style_stepline, editable = true)

var float gUpper = 0.0
var float gLower = 0.0
gUpper := math.max(gSource, nz(gUpper[1])) - nz(gUpper[1] - gLower[1]) / gLength
gLower := math.min(gSource, nz(gLower[1])) + nz(gUpper[1] - gLower[1]) / gLength
float gAverage = math.avg(gUpper, gLower)

bool gCrossUp = gLower[1] < close[1] and gLower > close
bool gCrossDown = gUpper[1] < close[1] and gUpper > close
bool gBullish = ta.barssince(gCrossDown) <= ta.barssince(gCrossUp)

color gAverageColor = gBullish ? color.new(color.lime, 90) : color.new(color.red, 90)
color gCloseColor = gBullish ? color.new(color.lime, 100) : color.new(color.red, 100)
color gCloudColor = gBullish ? color.new(color.lime, 90) : color.new(color.red, 90)

gAveragePlot = plot(showGChannel ? gAverage : na, "G-Channel Average", color = gAverageColor, linewidth = 1, editable = true)
gClosePlot = plot(showGChannel ? close : na, "G-Channel Close Price", color = gCloseColor, linewidth = 1, editable = true)
fill(gAveragePlot, gClosePlot, color = showGChannel ? gCloudColor : na, title = "G-Channel Cloud", editable = true)

bool gSellSignal = showGSignals and not gBullish and gBullish[1]
bool gBuySignal = showGSignals and gBullish and not gBullish[1]

plotshape(gSellSignal ? gAverage : na, title = "G-Channel Sell", location = location.absolute, style = shape.labeldown, color = color.red, size = size.tiny, text = "Sell", textcolor = color.white, offset = -1, editable = true)
plotshape(gBuySignal ? gAverage : na, title = "G-Channel Buy", location = location.absolute, style = shape.labelup, color = color.lime, size = size.tiny, text = "Buy", textcolor = color.white, offset = -1, editable = true)

alertcondition(gBuySignal, "G-Channel Buy", "G-Channel Buy on {{ticker}} {{interval}} at {{close}}")
alertcondition(gSellSignal, "G-Channel Sell", "G-Channel Sell on {{ticker}} {{interval}} at {{close}}")
