{
  "schemaVersion": 1,
  "scope": {
    "task": "Task 0: freeze domain decisions and characterize existing behavior",
    "instrument": "BTC",
    "symbolId": "BTCUSDT",
    "productionImplementationIncluded": false,
    "goldIncluded": false
  },
  "challengeV1": {
    "arithmetic": {
      "moneyScale": 6,
      "quantityScale": 8,
      "rounding": "round-half-to-even at each ledger posting"
    },
    "accounting": {
      "cash": "starting cash plus settled gross P&L minus every charged commission",
      "equity": "cash plus unrealized P&L",
      "usedMargin": "sum of open-position entry notional divided by admitted leverage",
      "reservedMargin": "sum of accepted unfilled order notional divided by admitted leverage",
      "freeMargin": "equity minus used margin minus reserved margin",
      "marginIsExpense": false
    },
    "execution": {
      "marketSlippageTicks": 1,
      "sameBarPath": {
        "upCandle": [
          "open",
          "low",
          "high",
          "close"
        ],
        "downCandle": [
          "open",
          "high",
          "low",
          "close"
        ]
      },
      "gapThroughProtectiveStop": "fill at the first observable executable price when it is worse than the stop; otherwise fill at the stop",
      "reversal": "close the existing quantity first, allocate the fill commission by notional, then open the residual quantity with fresh protective-order state",
      "replayActionTiming": "an action recorded after the current candle is consumed can execute no earlier than the next causal market observation"
    },
    "rules": {
      "oneStepTargets": [
        "0.10"
      ],
      "twoStepTargets": [
        "0.10",
        "0.08"
      ],
      "minimumActiveDays": 3,
      "minimumProfitableDays": 3,
      "profitableDayThreshold": "0.001",
      "inactivityDays": 30,
      "maximumLeverage": 20,
      "dailyLossLimit": "0.05",
      "maximumLossLimit": "0.10",
      "maximumLossMode": "static",
      "trailingLossSupported": true,
      "trailingLossEnabledForPreset": false,
      "dayTimezone": "UTC",
      "breachComparison": "less-than-or-equal",
      "simultaneousTargetAndBreach": "breach-wins",
      "targetBasis": "cash",
      "targetRequiresFlatAccount": true
    },
    "instrumentPolicy": {
      "symbol": "BTCUSDT",
      "policyVersion": "mcs.btcusdt/1",
      "priceScale": 6,
      "quantityScale": 8,
      "priceTick": "0.1",
      "quantityStep": "0.00001",
      "minimumQuantity": "0.00001",
      "minimumNotional": "5",
      "priceRounding": {
        "command": "reject",
        "derived": "adverse"
      },
      "quantityRounding": {
